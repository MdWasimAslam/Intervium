# ---------------------------------------------------------------------------
# Environment variables — copy to `.env.local` and fill in.
#   cp .env.local.example .env.local
# ---------------------------------------------------------------------------

# Neon Postgres connection string.
# Provided automatically by the Vercel <-> Neon integration in production.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret used to sign Auth.js JWT sessions. Generate: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret

# Google Gemini API key (server-side only — never expose to the client).
GEMINI_API_KEY=your-gemini-api-key

# Voice transcription provider: "webspeech" (default, free, client-side) or "groq".
NEXT_PUBLIC_TRANSCRIPTION_PROVIDER=webspeech

# Groq API key — only needed when NEXT_PUBLIC_TRANSCRIPTION_PROVIDER=groq (server-side only).
GROQ_API_KEY=your-groq-api-key
