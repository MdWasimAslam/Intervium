# ---------------------------------------------------------------------------
# Environment variables
# Copy this file to `.env.local` and fill in the values.
#   cp .env.local.example .env.local
# ---------------------------------------------------------------------------

# Neon Postgres connection string.
# Provided automatically by the Vercel <-> Neon integration in production.
# For local development, copy the "POSTGRES_URL" value from your Neon /
# Vercel project settings.
POSTGRES_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret used to sign JWT session tokens. Use a long random string.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret
