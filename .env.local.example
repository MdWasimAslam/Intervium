# ---------------------------------------------------------------------------
# Environment variables — copy to `.env.local` and fill in.
#   cp .env.local.example .env.local
# ---------------------------------------------------------------------------

# Neon Postgres connection string.
# Provided automatically by the Vercel <-> Neon integration in production.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret used to sign Auth.js JWT sessions. Generate: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret

# Groq API key for chat completions.
GROQ_API_KEY=your-groq-api-key

# Fast model: question generation and question-bank top-ups.
GROQ_FAST_MODEL=llama-3.1-8b-instant

# Smart model: interview scoring, result summaries, ATS/CV analysis, and CV rewrites.
GROQ_SMART_MODEL=llama-3.3-70b-versatile
