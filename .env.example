# ---------------------------------------------------------------------------
# Intervium environment variables — copy to `.env.local` and fill in.
#   cp .env.example .env.local
# All secrets are server-side only and must never be exposed to the client.
# ---------------------------------------------------------------------------

# === Required ===============================================================
# The app fails fast at boot (src/lib/env.ts) if any of these are missing.

# Neon Postgres connection string (the Vercel <-> Neon integration provides
# this automatically in production).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret used to sign Auth.js (NextAuth) JWT sessions.  openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret

# Groq API key — powers question generation, scoring, and CV AI.
GROQ_API_KEY=your-groq-api-key

# === Optional: Groq model selection (sensible defaults shown) ===============

# Fast model: question generation and question-bank top-ups.
GROQ_FAST_MODEL=llama-3.1-8b-instant

# Smart model: interview scoring, result summaries, ATS/CV analysis, rewrites.
GROQ_SMART_MODEL=llama-3.3-70b-versatile

# JSON override of per-model rate limits (model name -> partial limits), used by
# the AI usage dashboard. Ignored if not valid JSON. Defaults to the built-in
# free-tier table in src/lib/ai-limits.ts.
# GROQ_MODEL_LIMITS={"llama-3.1-8b-instant":{"rpm":30}}

# Daily AI request budget guard (integer). Defaults to the value in
# src/lib/ai-limits.ts when unset.
# AI_DAILY_BUDGET=1000

# === Optional: DeepSeek provider (alternative to Groq) ======================
# Only needed if a flow is configured to use the "deepseek" provider.
# DEEPSEEK_API_KEY=your-deepseek-api-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash

# === Optional: misc =========================================================

# Public site URL — used for absolute OG/social image URLs in metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Developer-only QA Center toggle. "true"/"1" forces it on; anything else off.
# When unset it defaults on outside production and 404s in production.
# QA_DASHBOARD_ENABLED=true

# Seed-time only: chosen admin password for `npm run db:seed`. If unset, the
# seed generates a random password and prints a notice to rotate it. Never
# commit a real value.
# ADMIN_PASSWORD=
