# ---------------------------------------------------------------------------
# Intervium environment variables — copy to `.env.local` and fill in.
#   cp .env.example .env.local
# All secrets are server-side only and must never be exposed to the client.
# ---------------------------------------------------------------------------

# Neon Postgres connection string (Vercel ↔ Neon integration provides this in prod).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret used to sign Auth.js (NextAuth) JWT sessions.  openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret

# Groq API key — powers question generation, scoring, CV AI, and optional Whisper transcription.
GROQ_API_KEY=your-groq-api-key

# Fast model: question generation and question-bank top-ups.
GROQ_FAST_MODEL=llama-3.1-8b-instant

# Smart model: interview scoring, result summaries, ATS/CV analysis, and CV rewrites.
GROQ_SMART_MODEL=llama-3.3-70b-versatile

# Public site URL — used for absolute OG/social image URLs in metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
