# ---------------------------------------------------------------------------
# Intervium environment variables — copy to `.env.local` and fill in.
#   cp .env.example .env.local
# All secrets are server-side only and must never be exposed to the client.
# ---------------------------------------------------------------------------

# Neon Postgres connection string (Vercel ↔ Neon integration provides this in prod).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret used to sign Auth.js (NextAuth) JWT sessions.  openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret

# Google Gemini API key — powers question generation & answer scoring (server-only).
GEMINI_API_KEY=your-gemini-api-key

# Groq API key — used by the "whisper" transcription provider (admin Settings).
# With this set, /api/transcribe uses Groq Whisper (hosted, works on Vercel);
# without it, it falls back to local whisper.cpp (offline dev only). Server-only.
GROQ_API_KEY=your-groq-api-key

# Public site URL — used for absolute OG/social image URLs in metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
