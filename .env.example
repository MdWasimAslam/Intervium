# Intervium environment variables. Copy to .env.local and fill in:
#   cp .env.example .env.local
# All secrets are server-side only — never expose to the client.

# === Required (app fails to boot without these — see src/lib/env.ts) ===
DATABASE_URL=postgresql://user:password@host:6543/dbname   # Postgres (Supabase/Neon). Use the TRANSACTION-mode pooler (port 6543), NOT session mode (5432): session mode caps clients at pool_size:15 → EMAXCONNSESSION. URL-encode special chars in the password (@ -> %40).
AUTH_SECRET=replace-with-a-long-random-secret              # Auth.js JWT signing. Generate: openssl rand -base64 32
GROQ_API_KEY=your-groq-api-key                             # Powers question generation, scoring, and CV AI.
DEEPSEEK_API_KEY=your-deepseek-api-key                     # DeepSeek provider

# === Optional ===
# Groq model overrides (defaults shown; see src/lib/ai-limits.ts).
# GROQ_FAST_MODEL=llama-3.1-8b-instant      # question generation / bank top-ups
# GROQ_SMART_MODEL=llama-3.3-70b-versatile  # scoring, summaries, ATS/CV, rewrites
# GROQ_MODEL_LIMITS={"llama-3.1-8b-instant":{"rpm":30}}  # JSON per-model rate-limit overrides
# AI_DAILY_BUDGET=1000                       # daily AI request budget guard

# DeepSeek provider (only when an admin toggles the provider to "deepseek").
# DEEPSEEK_API_KEY=your-deepseek-api-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash

# Misc.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000  # absolute URL for OG/social images (set to real domain in prod)
# QA_DASHBOARD_ENABLED=true                   # force QA Center on; defaults on outside prod, 404s in prod
# ADMIN_PASSWORD=                             # seed-time only (npm run db:seed); never commit a real value
